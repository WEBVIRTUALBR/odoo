<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="wvse_health_issue_view_tree" model="ir.ui.view">
      <field name="name">wvse.health.issue.tree</field>
      <field name="model">wvse.health.issue</field>
      <field name="arch" type="xml">
        <tree>
          <field name="create_date"/>
          <field name="run_id"/>
          <field name="issue_type"/>
          <field name="severity"/>
          <field name="model_name"/>
          <field name="res_id"/>
          <field name="employee_id"/>
          <field name="project_id"/>
          <field name="task_id"/>
          <field name="can_fix"/>
          <field name="fix_state"/>
          <field name="fixed_on"/>
        </tree>
      </field>
    </record>

    <record id="wvse_health_issue_view_kanban" model="ir.ui.view">
      <field name="name">wvse.health.issue.kanban</field>
      <field name="model">wvse.health.issue</field>
      <field name="arch" type="xml">
        <kanban>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_card">
                <strong><field name="issue_type"/></strong>
                <div><small><field name="severity"/></small></div>
                <div><span>Model:</span> <field name="model_name"/></div>
                <div><span>ID:</span> <field name="res_id"/></div>
                <div><span>Fix:</span> <field name="fix_state"/></div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="wvse_health_issue_view_form" model="ir.ui.view">
      <field name="name">wvse.health.issue.form</field>
      <field name="model">wvse.health.issue</field>
      <field name="arch" type="xml">
        <form string="Health Issue">
          <header>
            <button name="action_apply_fix" type="object" string="Apply Fix" class="oe_highlight"
                    attrs="{'invisible': [('can_fix','=',False),('fix_state','!=','pending')]}"
                    groups="wvse_odoo_health_monitor.group_wvse_health_manager"/>
            <button name="action_open_record" type="object" string="Open Record"/>
            <field name="fix_state" widget="statusbar" statusbar_visible="pending,fixed,failed,skipped"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="issue_type"/></h1>
            </div>

            <group>
              <group>
                <field name="run_id" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="severity" readonly="1"/>
              </group>
              <group>
                <field name="model_name" readonly="1"/>
                <field name="res_id" readonly="1"/>
                <field name="can_fix" readonly="1"/>
              </group>
            </group>

            <group>
              <field name="description" readonly="1"/>
            </group>

            <notebook>
              <page string="Before/After">
                <group>
                  <field name="old_values_json" readonly="1"/>
                  <field name="new_values_json" readonly="1"/>
                </group>
              </page>
              <page string="Fix Result">
                <group>
                  <field name="fixed_by" readonly="1"/>
                  <field name="fixed_on" readonly="1"/>
                  <field name="fix_message" readonly="1"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="wvse_health_issue_action" model="ir.actions.act_window">
      <field name="name">Health Issues</field>
      <field name="res_model">wvse.health.issue</field>
      <field name="view_mode">tree,form,kanban</field>
      <field name="context">{}</field>
    </record>

  </data>
</odoo>
