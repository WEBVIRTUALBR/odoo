<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="wvse_health_run_view_tree" model="ir.ui.view">
      <field name="name">wvse.health.run.tree</field>
      <field name="model">wvse.health.run</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="state"/>
          <field name="triggered_by"/>
          <field name="started_on"/>
          <field name="finished_on"/>
          <field name="issues_total"/>
          <field name="fixed_total"/>
          <field name="failed_total"/>
        </tree>
      </field>
    </record>

    <record id="wvse_health_run_view_kanban" model="ir.ui.view">
      <field name="name">wvse.health.run.kanban</field>
      <field name="model">wvse.health.run</field>
      <field name="arch" type="xml">
        <kanban default_group_by="state" color="color" class="o_kanban_small_column o_kanban_project_tasks" sample="1">
            <field name="name"/>
            <field name="state" readonly="1"/>
            <field name="triggered_by"/>
            <field name="started_on"/>
            <field name="finished_on"/>
            <field name="issues_total"/>
            <field name="fixed_total"/>
            <field name="failed_total"/>
            <field name="health_level"/>
            <field name="company_id"/>
            <field name="color"/> 
              <templates>
                <t t-name="kanban-box">
                      <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click shadow-sm border-0">
                          <div class="o_kanban_record_top mb-2">
                              <div class="o_kanban_record_headings">
                                  <strong class="o_kanban_record_title text-primary" style="font-size: 1.1em;">
                                      <field name="name"/>
                                  </strong>
                                <div class="text-muted mt-1">
                                    <i class="fa fa-building-o mr-1"/> <field name="company_id"/>
                                </div>
                            </div>
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown" href="#" aria-label="Menu" title="Menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a type="edit" class="dropdown-item">Editar</a>
                                    <a type="delete" class="dropdown-item">Excluir</a>
                                </div>
                            </div>
                        </div>

                        <div class="o_kanban_record_body">
                            <div class="d-flex justify-content-between mb-3 text-center">
                                <div class="px-2">
                                    <div class="text-muted small">Total</div>
                                    <span class="badge badge-pill badge-secondary"><field name="issues_total"/></span>
                                </div>
                                <div class="px-2 border-left border-right">
                                    <div class="text-success small">Corrigidos</div>
                                    <span class="badge badge-pill badge-success"><field name="fixed_total"/></span>
                                </div>
                                <div class="px-2">
                                    <div class="text-danger small">Falhas</div>
                                    <span class="badge badge-pill badge-danger"><field name="failed_total"/></span>
                                </div>
                            </div>

                            <div class="o_kanban_record_subtitle small">
                                <div t-if="record.started_on.raw_value">
                                    <i class="fa fa-play-circle-o text-info"/> <strong>Início:</strong> <field name="started_on"/>
                                </div>
                                <div t-if="record.finished_on.raw_value" class="mt-1">
                                    <i class="fa fa-stop-circle-o text-muted"/> <strong>Fim:</strong> <field name="finished_on"/>
                                </div>
                            </div>
                        </div>

                        <div class="o_kanban_record_bottom mt-3 border-top pt-2">
                            <div class="oe_kanban_bottom_left">
                                <span class="badge badge-light border"><i class="fa fa-bolt mr-1 text-warning"/> <field name="triggered_by"/></span>
                            </div>
                            <div class="oe_kanban_bottom_right d-flex align-items-center">
                                <t t-set="status_color" t-value="'#16A34A'"/> <t t-if="record.health_level.raw_value == 'warning'" t-set="status_color" t-value="'#F59E0B'"/> <t t-if="record.health_level.raw_value == 'error'" t-set="status_color" t-value="'#DC2626'"/> <span class="o_status_bubble mx-0" 
                                      t-attf-style="background-color: {{status_color}}; width: 12px; height: 12px; border-radius: 50%; display: inline-block;" 
                                      t-att-title="record.health_level.value"/>

                                <field name="create_uid" widget="many2one_avatar_user" class="ml-2"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
      </field>
    </record>

    <record id="wvse_health_run_view_form" model="ir.ui.view">
      <field name="name">wvse.health.run.form</field>
      <field name="model">wvse.health.run</field>
      <field name="arch" type="xml">
        <form string="Health Run">
          <header>
            <button name="action_run_now" type="object" string="Run Checks" class="oe_highlight" groups="wvse_odoo_health_monitor.group_wvse_health_manager"/>
            <button name="action_apply_fixes" type="object" string="Apply Fixes" groups="wvse_odoo_health_monitor.group_wvse_health_manager"/>
            <button name="action_send_summary" type="object" string="Send Email Summary" groups="wvse_odoo_health_monitor.group_wvse_health_manager"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
            </div>

            <div class="oe_button_box" name="button_box">
              <button type="action" name="%(wvse_health_issue_action)d" class="oe_stat_button" icon="fa-exclamation-triangle">
                <field name="issues_total" widget="statinfo" string="Issues"/>
              </button>
              <button type="object" name="action_apply_fixes" class="oe_stat_button" icon="fa-wrench" groups="wvse_odoo_health_monitor.group_wvse_health_manager">
                <field name="fixed_total" widget="statinfo" string="Fixed"/>
              </button>
              <button type="object" name="action_send_summary" class="oe_stat_button" icon="fa-envelope" groups="wvse_odoo_health_monitor.group_wvse_health_manager">
                <span class="o_stat_text">Email</span>
              </button>
            </div>

            <group>
              <group>
                <field name="state" readonly="1"/>
                <field name="triggered_by" readonly="1"/>
                <field name="company_id" readonly="1"/>
              </group>
              <group>
                <field name="started_on" readonly="1"/>
                <field name="finished_on" readonly="1"/>
              </group>
            </group>

            <notebook>
              <page string="Summary">
                <field name="summary_html" nolabel="1" readonly="1"/>
              </page>
              <page string="Issues">
                <field name="issue_ids" readonly="1">
                  <tree>
                    <field name="issue_type"/>
                    <field name="severity"/>
                    <field name="model_name"/>
                    <field name="res_id"/>
                    <field name="employee_id"/>
                    <field name="project_id"/>
                    <field name="task_id"/>
                    <field name="can_fix"/>
                    <field name="fix_state"/>
                    <field name="fixed_on"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="wvse_health_run_action" model="ir.actions.act_window">
      <field name="name">Health Runs</field>
      <field name="res_model">wvse.health.run</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Runs record daily health checks and safe fixes.
        </p>
      </field>
    </record>

    <record id="wvse_health_run_action_kanban" model="ir.actions.act_window">
      <field name="name">Health Dashboard</field>
      <field name="res_model">wvse.health.run</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
    </record>

  </data>
</odoo>
