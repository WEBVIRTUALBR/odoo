<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_res_config_settings_wvse_health" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.wvse.health</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('settings')]" position="inside">
          <div class="app_settings_block" data-string="Odoo Health" string="Odoo Health">
            <h2>Odoo Health</h2>
            <div class="row mt16 o_settings_container">

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_health_timezone"/>
                  <div class="text-muted">Timezone used to compute day boundaries for safe checks.</div>
                  <field name="wvse_health_timezone"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_support_email"/>
                  <div class="text-muted">Email that receives daily health summary.</div>
                  <field name="wvse_support_email"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_autofix_enabled"/>
                  <div class="text-muted">Enable automatic safe fixes in daily cron.</div>
                  <field name="wvse_autofix_enabled"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_attendance_autoclose_on_checkin"/>
                  <div class="text-muted">Auto-close old open attendance before new check-in.</div>
                  <field name="wvse_attendance_autoclose_on_checkin"/>
                </div>
              </div>

              <div class="col-12">
                <h3>Timesheet thresholds</h3>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_min_calc_minutes"/>
                  <div class="text-muted">Minimum calculated minutes to evaluate.</div>
                  <field name="wvse_min_calc_minutes"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_min_abs_diff_minutes"/>
                  <div class="text-muted">Minimum absolute difference in minutes for timer mismatch.</div>
                  <field name="wvse_min_abs_diff_minutes"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_ratio_low"/>
                  <div class="text-muted">Low ratio threshold (stored/calculated).</div>
                  <field name="wvse_ratio_low"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_ratio_high"/>
                  <div class="text-muted">High ratio threshold (stored/calculated).</div>
                  <field name="wvse_ratio_high"/>
                </div>
              </div>

              <div class="col-12 col-lg-6 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <label for="wvse_min_abs_diff_hours"/>
                  <div class="text-muted">Minimum absolute difference in hours for unit_amount mismatch.</div>
                  <field name="wvse_min_abs_diff_hours"/>
                </div>
              </div>

            </div>
          </div>
        </xpath>
      </field>
    </record>

    <record id="wvse_health_settings_action" model="ir.actions.act_window">
      <field name="name">Odoo Health Settings</field>
      <field name="res_model">res.config.settings</field>
      <field name="view_mode">form</field>
      <field name="target">current</field>
      <field name="context">{'module': 'wvse_odoo_health_monitor'}</field>
    </record>

  </data>
</odoo>
