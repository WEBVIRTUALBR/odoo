<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="wvse_health_schedule_wizard_view_form" model="ir.ui.view">
      <field name="name">wvse.health.schedule.wizard.form</field>
      <field name="model">wvse.health.schedule.wizard</field>
      <field name="arch" type="xml">
        <form string="Agendar Execução">
          <group>
            <field name="nextcall"/>
          </group>
          <footer>
            <button name="action_schedule" type="object" string="Agendar" class="oe_highlight"/>
            <button string="Cancelar" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="wvse_health_schedule_wizard_action" model="ir.actions.act_window">
      <field name="name">Agendar Execução</field>
      <field name="res_model">wvse.health.schedule.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="context">{}</field>
    </record>

  </data>
</odoo>
